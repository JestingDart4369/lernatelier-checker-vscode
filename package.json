{
  "name": "lernatelier-checker",
  "displayName": "Lernatelier Checker",
  "description": "Prüft Lernatelier-Dokumentationen (Lernperiode-N.md) beim Schreiben auf formale Vollständigkeit: Ampel in der Statusleiste und Hinweise direkt in der Datei.",
  "version": "0.4.0",
  "publisher": "JestingDart4369",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#eee3c9",
    "theme": "light"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JestingDart4369/lernatelier-checker-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/JestingDart4369/lernatelier-checker-vscode/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Education"
  ],
  "keywords": [
    "lernatelier",
    "lernperiode",
    "markdown",
    "checker",
    "linter",
    "ims",
    "schule"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "workspaceContains:**/Lernperiode-*.md",
    "onView:lernatelier.panel"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lernatelier.check",
        "title": "Dokument prüfen",
        "category": "Lernatelier",
        "icon": "$(checklist)"
      },
      {
        "command": "lernatelier.showReport",
        "title": "Bericht anzeigen",
        "category": "Lernatelier"
      },
      {
        "command": "lernatelier.newPeriod",
        "title": "Neue Lernperiode erstellen …",
        "category": "Lernatelier"
      },
      {
        "command": "lernatelier.createConfig",
        "title": "Kalender bearbeiten (lernperiode.json) …",
        "category": "Lernatelier",
        "icon": "$(calendar)"
      },
      {
        "command": "lernatelier.addDay",
        "title": "Nächste Tagesplanung einfügen",
        "category": "Lernatelier"
      },
      {
        "command": "lernatelier.openPeriod",
        "title": "Lernperiode öffnen …",
        "category": "Lernatelier"
      },
      {
        "command": "lernatelier.checkWorkspace",
        "title": "Alle Lernperioden im Ordner prüfen",
        "category": "Lernatelier"
      },
      {
        "command": "lernatelier.ignoreFile",
        "title": "Diese Lernperiode ignorieren",
        "category": "Lernatelier",
        "icon": "$(eye-closed)"
      },
      {
        "command": "lernatelier.unignoreFile",
        "title": "Diese Lernperiode wieder prüfen",
        "category": "Lernatelier",
        "icon": "$(eye)"
      },
      {
        "command": "lernatelier.ignoreOlder",
        "title": "Ältere Lernperioden ignorieren",
        "category": "Lernatelier"
      },
      {
        "command": "lernatelier.carryOver",
        "title": "Offene Arbeitspakete übernehmen",
        "category": "Lernatelier",
        "icon": "$(arrow-right)"
      },
      {
        "command": "lernatelier.welcome",
        "title": "Erste Schritte",
        "category": "Lernatelier"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lernatelier.check",
          "when": "resourceLangId == markdown && resourceFilename =~ /^Lernperiode-.*\\.md$/i",
          "group": "navigation"
        },
        {
          "command": "lernatelier.createConfig",
          "when": "resourceLangId == markdown && resourceFilename =~ /^Lernperiode-.*\\.md$/i",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "lernatelier.check",
          "when": "editorLangId == markdown"
        },
        {
          "command": "lernatelier.addDay",
          "when": "editorLangId == markdown"
        },
        {
          "command": "lernatelier.carryOver",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "Lernatelier Checker",
      "properties": {
        "lernatelier.enable": {
          "type": "boolean",
          "default": true,
          "description": "Lernatelier-Dokumente automatisch prüfen."
        },
        "lernatelier.filePattern": {
          "type": "string",
          "default": "**/Lernperiode-*.md",
          "description": "Glob-Muster für die Dateien, die geprüft werden."
        },
        "lernatelier.checkWhileTyping": {
          "type": "boolean",
          "default": true,
          "description": "Beim Tippen prüfen. Ausgeschaltet wird nur beim Öffnen und Speichern geprüft."
        },
        "lernatelier.checkWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Alle Lernperiode-Dateien im geöffneten Ordner prüfen, nicht nur die offenen. Die Ampel in der Statusleiste zeigt immer die Datei, in der du gerade bist."
        },
        "lernatelier.inlineHints": {
          "type": "boolean",
          "default": true,
          "description": "Am Ende der Überschriften anzeigen: Arbeitspakete pro Tag, Wörter der Reflexionen und Zeichen der Grobplanung."
        },
        "lernatelier.explorerBadges": {
          "type": "boolean",
          "default": true,
          "description": "Im Explorer ein ✓ hinter fertigen Lernperioden und ein – hinter ignorierten anzeigen. Fehler und Warnungen färbt VS Code selbst rot und gelb."
        },
        "lernatelier.reminder": {
          "type": "boolean",
          "default": true,
          "description": "Einmal am Tag erinnern, wenn die Tagesplanung für heute oder den nächsten Unterrichtstag noch fehlt (nur mit Kalender)."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "lernperiode.json",
          "lernperiode-*.json"
        ],
        "url": "./schemas/lernperiode.schema.json"
      }
    ],
    "snippets": [
      {
        "language": "markdown",
        "path": "./dist/snippets.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lernatelier",
          "title": "Lernatelier",
          "icon": "images/activitybar.svg"
        }
      ]
    },
    "views": {
      "lernatelier": [
        {
          "type": "webview",
          "id": "lernatelier.panel",
          "name": "Übersicht",
          "icon": "images/activitybar.svg",
          "contextualTitle": "Lernatelier"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "start",
        "title": "Lernatelier Checker: Erste Schritte",
        "description": "In fünf Schritten von der leeren Datei zur grünen Ampel.",
        "steps": [
          {
            "id": "newPeriod",
            "title": "Lernperiode erstellen",
            "description": "Lege eine neue Lernperiode aus der Vorlage an. Die Datei heisst Lernperiode-N.md.\n[Neue Lernperiode erstellen](command:lernatelier.newPeriod)",
            "media": {
              "markdown": "media/walkthrough/newPeriod.md"
            },
            "completionEvents": [
              "onCommand:lernatelier.newPeriod"
            ]
          },
          {
            "id": "calendar",
            "title": "Kalender einrichten",
            "description": "Wähle die Unterrichtstage deiner Lernperiode. Dann weiss die Erweiterung, welche Tage schon fällig sind.\n[Kalender bearbeiten](command:lernatelier.createConfig)",
            "media": {
              "markdown": "media/walkthrough/calendar.md"
            },
            "completionEvents": [
              "onCommand:lernatelier.createConfig"
            ]
          },
          {
            "id": "sidebar",
            "title": "Seitenleiste öffnen",
            "description": "Ampel, Fortschritt, Hinweise und alle Knöpfe findest du in der Seitenleiste „Lernatelier“.\n[Seitenleiste öffnen](command:workbench.view.extension.lernatelier)",
            "media": {
              "markdown": "media/walkthrough/sidebar.md"
            },
            "completionEvents": [
              "onView:lernatelier.panel"
            ]
          },
          {
            "id": "plan",
            "title": "Tag planen",
            "description": "Füge die nächste Tagesplanung ein. Offene Arbeitspakete vom letzten Tag kannst du mitnehmen.\n[Nächste Tagesplanung einfügen](command:lernatelier.addDay)",
            "media": {
              "markdown": "media/walkthrough/plan.md"
            },
            "completionEvents": [
              "onCommand:lernatelier.addDay",
              "onCommand:lernatelier.carryOver"
            ]
          },
          {
            "id": "fix",
            "title": "Fehler beheben",
            "description": "Rote und gelbe Stellen stehen im Problems-Fenster. Die Glühbirne (Ctrl+. oder Cmd+.) korrigiert vieles mit einem Klick.\n[Bericht anzeigen](command:lernatelier.showReport)",
            "media": {
              "markdown": "media/walkthrough/fix.md"
            },
            "completionEvents": [
              "onCommand:lernatelier.showReport"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs --test && node --test test/*.test.mjs test/upstream/*.test.mjs",
    "package": "npx --yes @vscode/vsce@4.1.0 package"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.17.0",
    "@types/unist": "^3.0.3",
    "@types/vscode": "~1.90.0",
    "esbuild": "^0.25.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5"
  }
}
